# From your GitHub App's settings page (github.com/settings/apps/<your-app>)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Either point directly at the downloaded .pem file (easiest — avoids
# copy-pasting a multi-line key)...
GITHUB_APP_PRIVATE_KEY_PATH=
# ...or paste the full key contents here instead, with newlines escaped as \n.
GITHUB_APP_PRIVATE_KEY=
# The app's url slug, e.g. "my-code-agent" from github.com/apps/my-code-agent
GITHUB_APP_SLUG=

# Origin of the web app, used for CORS.
WEB_APP_URL=http://localhost:3001

# Secret used to sign/verify session tokens handed to the web app. Generate
# with: openssl rand -hex 32
SESSION_SECRET=

PORT=3002
